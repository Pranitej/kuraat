# Copy to .env (git-ignored). Expo loads it for `npx expo start`.

# The kuraat server API as the PHONE sees it. A phone cannot use "localhost":
# use your laptop's Wi-Fi IP (PowerShell: ipconfig → "IPv4 Address"), e.g. http://192.168.1.25:4000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Optional: crash and error reports (Sentry). Leave empty to turn reporting off.
EXPO_PUBLIC_SENTRY_DSN=

# Optional build settings read by app.config.ts (the defaults below are right for this project; set them
# only to build under another Expo account/project, or to pick the build kind: development | preview | production).
# EAS_OWNER=pranitejrsof
# EAS_PROJECT_ID=e3508d94-a503-4b32-b38b-bdf0ed4e3682
# APP_VARIANT=development
