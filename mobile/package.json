{
  "name": "kuraat-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "kuraat â€” React Native (Expo) customer app for Android and iOS. Independent app: install, run and build from this folder.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm run test:logic && npm run test:ui",
    "test:logic": "vitest run",
    "test:ui": "jest",
    "parity": "node scripts/check-parity.mjs",
    "check:fingerprint": "node scripts/check-fingerprint.mjs",
    "doctor": "expo-doctor",
    "export:check": "expo export --platform android --platform ios --output-dir .export-check",
    "start:dev-client": "expo start --dev-client",
    "check": "npm run parity && npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
