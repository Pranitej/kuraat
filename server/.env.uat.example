# Copy to .env.uat (git-ignored) and fill in RSOF's UAT login. Then:
#   npm run rof:check:uat      read-only contract check against UAT
#   npm run dev:uat            the API against UAT (the fake RSOF and your .env stay untouched)
# Values here override .env. NEVER commit the real file.
ROF_BASE_URL=https://rofuat.rsof.com.sa
ROF_MEDIA_BASE_URL=https://rofuat.rsof.com.sa
ROF_EMAIL=
ROF_PASSWORD=
# The UAT login has Inventory.Read, so per-branch stock can be checked
ROF_INVENTORY_CHECK=true
ROF_TIMEOUT_MS=20000
