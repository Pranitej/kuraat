# kuraat server — copy to .env and fill in. Never commit .env.

PORT=4000
NODE_ENV=development

# Our database (MySQL 8). docker compose up -d gives you these.
DATABASE_URL=mysql://kuraat:kuraat@localhost:3307/kuraat
TEST_DATABASE_URL=mysql://kuraat:kuraat@localhost:3307/kuraat_test

# Login tokens for the app. Use long random strings (32+ characters) in every real environment.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

# Web origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# RSOF order system (ROF). Local fake: http://localhost:8080 · UAT: https://rofuat.rsof.com.sa
ROF_BASE_URL=http://localhost:8080
ROF_EMAIL=kuraat-app@rsof.local
ROF_PASSWORD=MockRof@2026
# true only if the ROF service user has the Inventory.Read permission
ROF_INVENTORY_CHECK=false
ROF_TIMEOUT_MS=10000

# WhatsApp login codes. "test" = nothing is sent; OTP_TEST_CODE always works.
OTP_MODE=test
OTP_TEST_CODE=123456

# Whether ROF sellingPrice already includes 15 % VAT.
PRICES_INCLUDE_VAT=true

# How often ongoing orders are re-checked with ROF (ms).
ORDER_POLL_INTERVAL_MS=60000

# bcrypt cost for passwords (12 in real environments; tests use 4 for speed)
PASSWORD_HASH_COST=12

# Fake ROF (npm run mock-rof)
MOCK_ROF_PORT=8080
MOCK_ROF_EMAIL=kuraat-app@rsof.local
MOCK_ROF_PASSWORD=MockRof@2026
# Seconds between automatic status steps for demo orders (empty = off)
MOCK_AUTO_ADVANCE_SECONDS=
