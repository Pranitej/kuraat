# kuraat server — copy to .env and fill in. Never commit .env.

PORT=4000
NODE_ENV=development

# Our database (MySQL 8). docker compose up -d gives you these.
DATABASE_URL=mysql://kuraat:kuraat@localhost:3307/kuraat
TEST_DATABASE_URL=mysql://kuraat:kuraat@localhost:3307/kuraat_test

# Login tokens for the app. Use long random strings (32+ characters) in every real environment.
# With NODE_ENV=production the server refuses to start while these still start with "change-me".
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

# Web origins allowed to call the API (comma-separated). The mobile app is not a web origin and
# needs no entry here; a phone in development reaches the API on the laptop's Wi-Fi IP (mobile/README.md).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# RSOF order system (ROF). UAT: https://rofuat.rsof.com.sa — there is no local stand-in; the app always talks to RSOF.
ROF_BASE_URL=https://rofuat.rsof.com.sa
# Optional: where the apps load product photos from (default: ROF_BASE_URL, which is right for RSOF).
ROF_MEDIA_BASE_URL=
# RSOF login — ask RSOF. Never commit the real values; this file is only an example.
ROF_EMAIL=
ROF_PASSWORD=
# true only if the RSOF login has Inventory.Read: checkout then skips a nearer branch that is out of stock
ROF_INVENTORY_CHECK=true
# Per RSOF call, in milliseconds (20000 suits UAT)
ROF_TIMEOUT_MS=20000

# WhatsApp login codes. "test" = nothing is sent; OTP_TEST_CODE always works.
# "whatsapp" = a random code is sent through RSOF's messaging API (the WHATSAPP_* settings below).
OTP_MODE=test
OTP_TEST_CODE=123456
# Needed only with OTP_MODE=whatsapp. Keep the real user/password out of git (this file is only an example).
# While RSOF's WhatsApp number is in testing it can message only the numbers RSOF has allowed.
WHATSAPP_API_BASE_URL=https://app.rofconsole.com/messaging
WHATSAPP_API_USER=
WHATSAPP_API_PASSWORD=
# The WhatsApp Business number that sends the code, with country code (e.g. +15551234567)
WHATSAPP_SENDER=
# The approved AUTHENTICATION template (its name and language) that carries the code
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Per messaging call, in milliseconds
WHATSAPP_TIMEOUT_MS=10000
# With NODE_ENV=production the server refuses OTP_MODE=test unless this is true (UAT only!)
OTP_ALLOW_TEST_IN_PRODUCTION=false
# RSOF's API key (sent as X-Api-Key on RSOF's key-based endpoints). Today it makes the online-payment links, so it
# needs the payments.link scope (ask the RSOF lead). Empty = online payment off (cash on delivery and pay at branch
# still work). Never commit the real key.
ROF_API_KEY=

# Cash payments: cash on delivery (deliveries) and pay at the branch (pickups). false = the customer can only pay online
# (the apps hide both options and the server refuses them). Set true to offer cash again.
CASH_PAYMENTS_ENABLED=false

# How often ongoing orders are re-checked with ROF (ms).
ORDER_POLL_INTERVAL_MS=60000

# bcrypt cost for passwords (12 in real environments; tests use 4 for speed)
PASSWORD_HASH_COST=12

# Requests per minute per IP to /auth/* (sign-in, codes)
AUTH_RATE_LIMIT_PER_MINUTE=20

# Behind a reverse proxy / load balancer set the number of proxies (usually 1) so rate limits use the client IP
TRUST_PROXY=
